    "digest": "node src/digest.mjs",
    "register": "node src/register.mjs",
    "dashboard": "node src/dashboard/server.mjs",
    "cron": "node src/cron.mjs",
    "report": "node src/report.mjs",
    "eval:llm": "node eval/llm/run.mjs",
