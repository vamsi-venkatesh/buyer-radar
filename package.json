  "repository": { "type": "git", "url": "https://github.com/vamsi-venkatesh/buyer-radar.git" },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node tools/validate.mjs",
