# Buyer Radar - example environment. Names and comments only.
# Never commit a real .env, and never put a real value in this file.
#
# Who the radar runs for is NOT set here. That lives in config/client.json
# (git-ignored; copy config/client.example.json), because it is configuration and
# not a secret. Everything below is a secret, an endpoint or an operational knob.

# ---------------------------------------------------------------- storage
# Optional. When set, leads, runs and events go to Postgres.
# When unset, the JSON file store under data/ is used and everything still runs.
DATABASE_URL=postgres://user:password@localhost:5432/buyer_radar

# ---------------------------------------------------------------- sources
# Optional. Free key from https://data.gov.in/ (register, then "My Account" -> API key).
# Without it the agmarknet source is skipped with a recorded reason; prices are never invented.
DATA_GOV_IN_KEY=

# Optional. The GeM public bid lane is OFF unless this is exactly "true".
# It is off by default because every request to the GeM estate from the machine
# this was built on timed out at the TCP connect stage on 2026-09-11, so the
# response shape its client parses is documented as assumed and has never been
# read. Switch it on only when you are ready to check a real response against
# the shape written down in the README - see "GeM was unreachable".
GEM_ENABLED=

# Optional override of the outbound User-Agent header. The default comes from
# business.userAgent in the client profile. Put a real contact address in it:
# every source we read is entitled to know who is reading it.
RADAR_USER_AGENT=

# ---------------------------------------------------------------- dashboard
# Required to start the dashboard. One long random string; the dashboard is
# owner-only and refuses to start without it.
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RADAR_OWNER_TOKEN=

# Port the dashboard listens on. Default 4710.
RADAR_PORT=4710

# ---------------------------------------------------------------- scheduler
# Local time of the daily run, HH:MM. Default 07:00.
RADAR_RUN_AT=07:00

# The time zone that RADAR_RUN_AT is read in. Default Asia/Kolkata.
RADAR_TZ=Asia/Kolkata

# Comma list of cities to run each morning, one run and one digest each.
# Known: whatever config/client.json configures. Default bengaluru.
RADAR_CITIES=bengaluru

# Comma list of sources for the scheduled run. Default overpass,news,agmarknet.
RADAR_SOURCES=overpass,news,agmarknet

# Maximum candidates carried into the register per run. Default 200.
RADAR_LIMIT=200

# Comma list of channels the scheduler delivers through: email, whatsapp, or both.
# Empty means the digest is written to files only. Default empty.
RADAR_DELIVER=

# ---------------------------------------------------------------- delivery
# The owner's own address. This is the ONLY recipient; no buyer is ever messaged.
RADAR_TO=

# Optional From address on the email. Defaults to RADAR_TO.
RADAR_FROM=

# SMTP submission over implicit TLS, port 465. Unset means the message is
# written to outbox/<date>.eml and the run records "not sent".
RADAR_SMTP_URL=smtps://user:password@smtp.example.com:465

# WhatsApp Cloud API. The phone number id from the Meta app dashboard.
WA_PHONE_NUMBER_ID=

# WhatsApp Cloud API access token. Unset means the request is written to
# outbox/<date>.whatsapp.json and the run records "not sent".
WA_TOKEN=

# The owner's WhatsApp number in international format, digits only, e.g. 9198...
# This is also the ONLY number whose inbound WhatsApp messages are acted on.
RADAR_TO_WA=

# ---------------------------------------------------------------- webhook
# The dashboard serves Meta's webhook at ${RADAR_BASE_PATH}/webhook.

# Any long random string. Meta echoes it back once, when the callback URL is
# verified. Unset means the GET verification answers 503.
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WA_VERIFY_TOKEN=

# The Meta app secret. Every POST body is HMAC-SHA256'd with it and compared
# with X-Hub-Signature-256. Unset means the webhook answers 503 and accepts
# nothing: an unsigned event is never trusted.
WA_APP_SECRET=

# Local test hook, off unless set. When set, an outbound WhatsApp text is posted
# to this URL instead of the Cloud API, so a reply can be observed without
# sending one. Never set this in production.
WA_FAKE_FETCH_URL=

# Optional URL prefix when the dashboard is served under a path, e.g. /radar.
RADAR_BASE_PATH=

# ---------------------------------------------------------------- the LLM stage
# The stage reads a lead's own page and writes a second opinion plus an opener.
# It never finds a lead, never sets a score and never sends anything. With no key
# below it does not run at all, and every score is exactly what the rules alone
# produce. See the README section "The LLM stage".

# The provider key. This is the switch: no key, no stage.
DEEPSEEK_API_KEY=

# Provider and model. LLM_PROVIDER is deepseek or openai-compatible.
LLM_PROVIDER=
LLM_MODEL=

# Only for LLM_PROVIDER=openai-compatible: the endpoint root and its key.
LLM_BASE_URL=
LLM_API_KEY=

# Kill switch. LLM_ENABLED=false turns the stage off even with a key present.
# Anything else leaves it on when a key exists. --no-llm does the same for one run.
LLM_ENABLED=

# How many leads are enriched per run, and how many openers are written.
# The opener count is capped by however many leads the digest actually shows.
LLM_ENRICH_LIMIT=
LLM_OPENER_TOP_N=

# The daily spend cap in INR, default 200. Spend is computed from the tokens the
# provider reported and the price table in config/llm-prices.json, and is stored,
# so restarting the process does not hand the cap back. Over the cap, the stage
# stops and the run continues without it.
LLM_DAILY_BUDGET_INR=

# The openings lane's per-run ceiling on article reads, and therefore on model
# calls, default 6. The lane only reads requirement candidates - an opening or
# an expansion story is kept as an awareness signal and costs nothing - and this
# is the ceiling under that rule. 0 turns article reading off for the run.
OPENINGS_MAX_READS=

# Optional: point the JSON store at another directory. Used by the tests and by
# any run that must not touch data/.
RADAR_DATA_DIR=

# The MCP server (npm run mcp). "owner" or "agent"; anything that is not exactly
# the word owner is an agent. An agent can read everything and change nothing:
# leads.set_status and owner.message both refuse and record the refusal.
RADAR_MCP_ACTOR=

# Optional: point the receipt and digest directories somewhere other than
# ./runs and ./digests. Used by the tests and by the MCP server when it runs
# from outside the project directory.
RADAR_RUNS_DIR=
RADAR_DIGESTS_DIR=
