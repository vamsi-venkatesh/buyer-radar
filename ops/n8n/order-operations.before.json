    {
      "parameters": {
        "jsCode": "const event = $json.body ?? $json;\nif (event.eventType !== 'order.created') throw new Error('Unsupported event type');\nconst order = event.order ?? {};\nconst required = ['orderId','createdAt','contactName','businessName','phone','city','businessType','orderDetails','schedule'];\nconst missing = required.filter((key) => !String(order[key] ?? '').trim());\nif (missing.length) throw new Error(`Missing order fields: ${missing.join(', ')}`);\nconst products = Array.isArray(order.products) ? order.products.filter(Boolean) : [];\nif (!products.length) throw new Error('Order has no products');\nconst operationsMessage = [`NEW ORDER — ${order.orderId}`, `${order.businessName} · ${order.businessType}`, `Contact: ${order.contactName} · ${order.phone}`, `Delivery: ${order.city}`, '', order.orderDetails, '', `Schedule: ${order.schedule}`, order.neededBy ? `Needed by: ${order.neededBy}` : '', order.notes ? `Notes: ${order.notes}` : ''].filter(Boolean).join('\\n');\nreturn [{ json: { event_id: event.eventId, event_type: event.eventType, occurred_at: event.occurredAt, order_id: order.orderId, created_at: order.createdAt, status: order.status || 'new-awaiting-confirmation', business: order.businessName, buyer_type: order.businessType, contact_name: order.contactName, phone: order.phone, email: order.email || '', city: order.city, products: products.join(', '), order_details: order.orderDetails, schedule: order.schedule, needed_by: order.neededBy || '', notes: order.notes || '', source: event.source || 'website', operations_message: operationsMessage, customer_message: `Thank you, ${order.contactName}. We have received order request ${order.orderId}. We will contact you to confirm availability, price, packing and delivery. No payment has been taken.` } }];"
      },
