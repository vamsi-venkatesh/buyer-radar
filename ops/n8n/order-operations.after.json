      "id": "webhook-order-created",
      "name": "Order Created Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -900,
        0
      ],
      "webhookId": "order-created",
      "credentials": {
        "httpHeaderAuth": {
          "name": "Order Webhook Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const event = $json.body ?? $json;\nif (event.eventType !== 'order.created') throw new Error('Unsupported event type');\nconst order = event.order ?? {};\nconst required = ['orderId','createdAt','contactName','businessName','phone','city','businessType','orderDetails','schedule'];\nconst missing = required.filter((key) => !String(order[key] ?? '').trim());\nif (missing.length) throw new Error(`Missing order fields: ${missing.join(', ')}`);\nconst products = Array.isArray(order.products) ? order.products.filter(Boolean) : [];\nif (!products.length) throw new Error('Order has no products');\n// The spreadsheet the Google Sheets node writes to. It is read from the n8n\n// environment so the id is configuration and not a value edited into a node;\n// set ORDERS_SHEET_ID on the n8n container, or paste the id on the node.\nlet sheetId = '';\ntry { sheetId = String($env.ORDERS_SHEET_ID ?? '').trim(); } catch (e) { sheetId = ''; }\nconst sheetName = (() => { try { return String($env.ORDERS_SHEET_NAME ?? '').trim() || 'Orders'; } catch (e) { return 'Orders'; } })();\nconst operationsMessage = [`NEW ORDER \\u2014 ${order.orderId}`, `${order.businessName} \\u00b7 ${order.businessType}`, `Contact: ${order.contactName} \\u00b7 ${order.phone}`, `Delivery: ${order.city}`, '', order.orderDetails, '', `Schedule: ${order.schedule}`, order.neededBy ? `Needed by: ${order.neededBy}` : '', order.notes ? `Notes: ${order.notes}` : ''].filter(Boolean).join('\\n');\nreturn [{ json: {\n  event_id: event.eventId, event_type: event.eventType, occurred_at: event.occurredAt,\n  order_id: order.orderId, created_at: order.createdAt,\n  status: order.status || 'new-awaiting-confirmation',\n  business: order.businessName, business_name: order.businessName,\n  buyer_type: order.businessType, business_type: order.businessType,\n  contact_name: order.contactName, phone: order.phone, email: order.email || '', city: order.city,\n  products: products.join(', '), order_details: order.orderDetails,\n  schedule: order.schedule, frequency: order.schedule, volume: order.volume || '',\n  needed_by: order.neededBy || '', notes: order.notes || '',\n  source_path: order.sourcePath || '', source: event.source || 'website',\n  sheet_id: sheetId, sheet_name: sheetName,\n  // The order exactly as the site sent it, for the radar to normalise itself.\n  radar_order: order,\n  operations_message: operationsMessage,\n  customer_message: `Thank you, ${order.contactName}. We have received order request ${order.orderId}. We will contact you to confirm availability, price, packing and delivery. No payment has been taken.`\n} }];"
      },
